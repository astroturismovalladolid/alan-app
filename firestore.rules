
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for data validation
    function isValidLocationPrecision() {
      return request.resource.data.locationPrecision in ['exact', 'approximate', 'anonymous'];
    }

    function isValidRating() {
      return request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
    }

    function isValidCoordinates() {
      return request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180;
    }

    function hasRequiredObservationFields() {
      return request.resource.data.keys().hasAll([
        'imageUrl', 'latitude', 'longitude', 'description',
        'rating', 'createdAt', 'authorName', 'reports',
        'locationPrecision', 'isAnonymous', 'ratings'
      ]);
    }

    function isAnonymousObservation() {
      return request.resource.data.isAnonymous == true;
    }

    function isAuthenticatedObservation() {
      return request.resource.data.get('authorId', null) != null;
    }

    // An update that touches only the given field(s) and nothing else.
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Any authenticated user may add or change their OWN entry in the
    // ratings map (and the recomputed top-level average), never someone
    // else's. addRating() in observations-fetch.ts writes both fields
    // together, so both are part of the same diff.
    function isValidRatingsUpdate() {
      let uid = request.auth.uid;
      let before = resource.data.get('ratings', {});
      let after = request.resource.data.ratings;
      return onlyChanges(['ratings', 'rating'])
        && after[uid] is number && after[uid] >= 1 && after[uid] <= 5
        && after.diff(before).affectedKeys().hasOnly([uid])
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
    }

    // `reports` is a list (not a map), so we can't diff it key-by-key the
    // way we do ratings. Bound it to a +/-1 size change (one report added
    // or removed per call, matching reportObservation/unreportObservation)
    // rather than trying to prove which entry changed.
    function isValidReportsUpdate() {
      let before = resource.data.get('reports', []);
      let after = request.resource.data.reports;
      return onlyChanges(['reports'])
        && after.size() >= 0
        && (after.size() == before.size() + 1 || after.size() == before.size() - 1 || after.size() == before.size());
    }

    // Observations collection rules
    match /observations/{observationId} {
      // Anyone can read observations (public data)
      allow read: if true;

      // Create observation rules
      allow create: if (
        // Must be authenticated OR creating anonymous observation
        (request.auth != null || isAnonymousObservation())
        // Must have all required fields
        && hasRequiredObservationFields()
        // Must have valid location precision
        && isValidLocationPrecision()
        // Must have valid rating
        && isValidRating()
        // Must have valid coordinates
        && isValidCoordinates()
        // Description must be at least 10 characters
        && request.resource.data.description.size() >= 10
        // Anonymous observations: no authorId field
        && (isAnonymousObservation() == (!request.resource.data.keys().hasAny(['authorId'])))
        // Authenticated observations: authorId must match authenticated user
        && (!isAuthenticatedObservation() || request.resource.data.authorId == request.auth.uid)
      );

      // Update observation rules. Three distinct, mutually exclusive cases:
      allow update: if request.auth != null && (
        // 1. The author edits their own description (nothing else changes).
        (resource.data.get('authorId', null) == request.auth.uid && onlyChanges(['description'])
          && request.resource.data.description.size() >= 10)
        // 2. Any authenticated user rates the observation (their own key only).
        || isValidRatingsUpdate()
        // 3. Any authenticated user reports/unreports the observation.
        || isValidReportsUpdate()
      );

      // Delete observation rules
      allow delete: if (
        // Must be authenticated
        request.auth != null
        // Can only delete if you are the author (anonymous observations cannot be deleted)
        && resource.data.authorId == request.auth.uid
      );
    }

    // User profiles collection rules
    match /users/{userId} {
      // Any authenticated user can read any user profile
      allow read: if request.auth != null;

      // Any authenticated user can create their own profile
      allow create: if request.auth != null && request.auth.uid == userId;

      // Users can only update or delete their own profile
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
