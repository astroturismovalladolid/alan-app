
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to observations for all users
    match /observations/{observationId} {
      allow read: if true;
      allow create: if request.auth != null;
    }
    
    // Allow users to manage their own profile
    match /users/{userId} {
      // Any authenticated user can read any user profile.
      // Any authenticated user can create their own user profile.
      // A user can only update or delete their own profile.
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
