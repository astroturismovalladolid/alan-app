# Firebase Extension: Resize Images
# This extension automatically creates resized versions of images uploaded to Cloud Storage

# Where do you store your images?
IMG_BUCKET=${param:PROJECT_ID}.appspot.com

# Paths that contain images you want to resize (comma-separated list)
# Match all images in observations and avatars folders
IMG_SIZES=200x200,400x400,800x800

# Path where you store your images
# The extension will monitor this path for new uploads
LOCATION=observations,avatars

# Absolute paths of the directories (comma-separated) where you want to resize images
INCLUDE_PATH_LIST=observations,avatars

# Absolute paths of the directories (comma-separated) where you do NOT want to resize images
# Leave empty to resize all images in INCLUDE_PATH_LIST
EXCLUDE_PATH_LIST=

# Sizes of thumbnails to generate (comma-separated list)
# Format: WIDTHxHEIGHT (e.g., 200x200,800x800)
# For observations: 800x800 max dimension (preserves aspect ratio)
# For avatars: 200x200 for small avatars
# Extension will preserve aspect ratio - dimensions are max width/height
RESIZE_SIZES=800x800

# Naming convention for resized images
# Options: AS_SUFFIX, AS_PREFIX
RESIZE_NAMING=AS_SUFFIX

# Convert images to WebP format (30-50% smaller)
OUTPUT_FORMAT=webp

# Quality for WebP conversion (1-100)
# 85 is a good balance between quality and file size
WEBP_QUALITY=85

# Delete original image after resizing (not recommended for production)
DELETE_ORIGINAL_FILE=false

# Cache-Control header for resized images
# public: can be cached by any cache
# max-age=31536000: cache for 1 year (365 days)
# immutable: file will never change
CACHE_CONTROL_HEADER=public,max-age=31536000,immutable
